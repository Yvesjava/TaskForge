<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.agent.dal.mysql.AgentProjectMapper">

    <!-- 按项目代号查询，命中唯一键 uk_project_code；租户条件由租户拦截器自动追加 -->
    <select id="selectByProjectCode" resultType="cn.iocoder.yudao.module.agent.dal.dataobject.AgentProjectDO">
        SELECT *
          FROM agent_project
         WHERE project_code = #{projectCode}
           AND deleted = 0
         ORDER BY id DESC
         LIMIT 1
    </select>

</mapper>
