# TaskForge local frontend development environment
#
# 前端本地开发统一约定（`pnpm dev` = `vite --mode env.local`，加载本文件复制出的 .env.local）：
#   端口     VITE_PORT=3000                      -> http://localhost:3000
#   API 基地址 VITE_BASE_URL + VITE_API_URL       -> http://localhost:48080/admin-api
# VITE_BASE_URL 为后端来源地址，VITE_API_URL 为 admin-api 前缀，二者拼接即为 axios base_url，
# 同时被文件上传、WebSocket、内嵌 iframe 等基础模块复用。可用 `pnpm check:env` 校验该约定。
NODE_ENV=development
VITE_DEV=true

VITE_APP_TITLE=TaskForge
VITE_PORT=3000
VITE_OPEN=false

VITE_BASE_URL=http://localhost:48080
VITE_UPLOAD_TYPE=server
VITE_API_URL=/admin-api

VITE_DROP_DEBUGGER=false
VITE_DROP_CONSOLE=false
VITE_SOURCEMAP=false
VITE_COMPRESS=none
VITE_BASE_PATH=/
VITE_MALL_H5_DOMAIN=http://localhost:3000
VITE_APP_CAPTCHA_ENABLE=false
VITE_GOVIEW_URL=http://127.0.0.1:3000
