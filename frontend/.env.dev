# TaskForge 前端 dev 环境变量模板。
#
# 由 `pnpm run dev-server`（vite --mode dev）与 `pnpm run build:dev`
# （vite build --mode dev）加载。本文件为受控提交模板：部署前请把占位域名替换为
# 真实 dev 网关地址，严禁写入任何真实凭证。约定与本地一致：
#   VITE_BASE_URL（后端来源地址）+ VITE_API_URL（admin-api 前缀）= 接口基地址。
VITE_DEV=true

VITE_APP_TITLE=TaskForge
VITE_PORT=3000
VITE_OPEN=false

VITE_BASE_URL=https://dev-api.example.com
VITE_UPLOAD_TYPE=server
VITE_API_URL=/admin-api

VITE_DROP_DEBUGGER=false
VITE_DROP_CONSOLE=false
VITE_SOURCEMAP=false
VITE_COMPRESS=none
VITE_BASE_PATH=/
VITE_MALL_H5_DOMAIN=https://mall.example.com
VITE_APP_CAPTCHA_ENABLE=false
VITE_GOVIEW_URL=https://goview.example.com
