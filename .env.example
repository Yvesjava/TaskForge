# TaskForge local development environment
# Docker Compose 会自动读取本文件（重命名为 `.env`）；Spring Boot 不会自动读取，
# 后端通过 `application-taskforge.yaml` 中的同名变量与默认值获取配置。

# ---- Docker Compose（MySQL / Redis）----
TASKFORGE_DB_NAME=taskforge
TASKFORGE_DB_USERNAME=root
TASKFORGE_DB_PASSWORD=taskforge_dev
TASKFORGE_MYSQL_PORT=3306
TASKFORGE_REDIS_PORT=6379
TASKFORGE_BACKEND_PORT=48080
TASKFORGE_FRONTEND_PORT=3000
TASKFORGE_FRONTEND_URL=http://localhost:3000

# ---- 后端 local,taskforge profile ----
# 默认按 TASKFORGE_DB_NAME + TASKFORGE_MYSQL_PORT 自动拼接 JDBC URL；
# 仅当需要指向其他数据库实例时才设置 TASKFORGE_DB_URL。
# TASKFORGE_DB_URL=jdbc:mysql://127.0.0.1:3306/taskforge?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&nullCatalogMeansCurrent=true&rewriteBatchedStatements=true
TASKFORGE_REDIS_HOST=127.0.0.1
TASKFORGE_REDIS_DATABASE=0
TASKFORGE_REDIS_PASSWORD=taskforge_dev

# Optional AI provider keys. Leave empty until the provider is enabled.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional Codex/Claude executor overrides. Defaults are provided in
# application-taskforge.yaml; uncomment only when the deployment differs.
# TASKFORGE_AGENT_EXEC_EXECUTABLE=codex
# TASKFORGE_AGENT_EXEC_TIMEOUT=30m
# TASKFORGE_AGENT_EXEC_MAX_OUTPUT_BYTES=262144
